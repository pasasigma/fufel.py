  "narrative": {
    "northStar": "Спокойный центр управления",
    "overview": "The implemented black and green world adapts the user-pinned Glassy Dashboard reference into a Russian-language operating space. Mint highlights and dark forest surfaces make the current workspace and primary action easy to distinguish; rounded containers keep dense controls approachable. This is a code-led record of the built interface, not an approved visual comp.\n\nDepth comes from tonal layering, translucent fills, fine borders and one broad green gradient. Manrope and Lucide line icons provide a consistent visual voice across member management, messages, audit and access settings. The review captures are demonstration data and do not establish production metrics.",
    "keyCharacteristics": [
      "Near-black canvas with green surfaces and mint actions.",
      "Locally bundled Manrope with compact supporting labels.",
      "Rounded panels, fine borders and restrained depth.",
      "Russian copy, tabular metrics and explicit status text."
    ],
    "rules": [
      {
        "name": "The Status Has Words Rule",
        "body": "Color reinforces an explicit status label; it never replaces one.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal fills and borders for resting containers; reserve shadows for transient layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the black and green identity and use dark text on mint actions.",
      "Do use the existing Manrope weights and Lucide line icons.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do label demonstration content and represent missing metrics with an em dash.",
      "Do keep member identity and the reason visible before confirming an operation."
    ],
    "donts": [
      "Don't turn the overview composition into a required layout for every screen.",
      "Don't add decorative charts or fabricate operational metrics.",
      "Don't describe the translucent fills as backdrop blur; none is implemented.",
      "Don't rely on color alone for audit status; retain icon and text."
    ]
  }
}
